<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: the sliders + status + buttons overflow a phone screen.
     The preview frame keeps a fixed height so the FIT_XY view-to-image
     mapping (and the handle-drag geometry) is unchanged. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calibration_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calib_hint" />

        <!-- FIT_XY so view coordinates map linearly to image coordinates. -->
        <FrameLayout
            android:id="@+id/calib_frame"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/calib_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/handle_tl"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/corner_handle" />

            <ImageView
                android:id="@+id/handle_tr"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/corner_handle" />

            <ImageView
                android:id="@+id/handle_br"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/corner_handle" />

            <ImageView
                android:id="@+id/handle_bl"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/corner_handle" />

        </FrameLayout>

        <Switch
            android:id="@+id/calib_show_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/calib_show_mask" />

        <TextView
            android:id="@+id/calib_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calib_status_no_frame" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/calib_brown_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/calib_brown_hint" />

        <TextView
            android:id="@+id/brown_h_lo_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/calib_h_lo" />

        <SeekBar
            android:id="@+id/brown_h_lo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="179" />

        <TextView
            android:id="@+id/brown_h_hi_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calib_h_hi" />

        <SeekBar
            android:id="@+id/brown_h_hi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="179" />

        <TextView
            android:id="@+id/brown_s_lo_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calib_s_lo" />

        <SeekBar
            android:id="@+id/brown_s_lo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255" />

        <TextView
            android:id="@+id/brown_s_hi_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calib_s_hi" />

        <SeekBar
            android:id="@+id/brown_s_hi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255" />

        <TextView
            android:id="@+id/brown_v_lo_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calib_v_lo" />

        <SeekBar
            android:id="@+id/brown_v_lo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255" />

        <TextView
            android:id="@+id/brown_v_hi_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calib_v_hi" />

        <SeekBar
            android:id="@+id/brown_v_hi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="255" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/calib_thresholds_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pocket_inset_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/calib_pocket_inset" />

        <SeekBar
            android:id="@+id/pocket_inset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000" />

        <TextView
            android:id="@+id/pocket_radius_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calib_pocket_radius" />

        <SeekBar
            android:id="@+id/pocket_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000" />

        <TextView
            android:id="@+id/ball_radius_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calib_ball_radius" />

        <SeekBar
            android:id="@+id/ball_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:min="1" />

        <Button
            android:id="@+id/btn_redetect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_redetect" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_save" />

        <Button
            android:id="@+id/btn_reset_defaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_reset_defaults" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_clear" />

    </LinearLayout>
</ScrollView>
