<?xml version="1.0" encoding="utf-8"?>
<!--
  8 Ball Pool Guideline Tool — manifest.
  Per-version checklist (ChatGPT, Android 10-15):
  - FOREGROUND_SERVICE_MEDIA_PROJECTION declared (Android 12+ mandatory).
  - POST_NOTIFICATIONS declared (Android 13+ runtime request).
  - CaptureService declares foregroundServiceType="mediaProjection|specialUse".
    Live capture starts with the mediaProjection type (it holds a real
    MediaProjection token). Demo mode has no token, and on Android 14+ a
    mediaProjection-type FGS without one throws SecurityException and
    crashes the process — so demo starts with the specialUse type on 34+
    (FOREGROUND_SERVICE_SPECIAL_USE + the subtype property below) and
    with the typeless startForeground overload below 34, where the token
    check does not exist.
  - No INTERNET permission: the tool is fully offline.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 12+ : mandatory for a mediaProjection foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 14+ : demo mode runs as a specialUse foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ : requested at runtime before starting capture -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PoolGuide">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.CalibrationActivity"
            android:exported="false"
            android:label="@string/calibration_title" />

        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Demo mode: loops a bundled synthetic table image through the CV pipeline so the user can preview the aim lines without starting screen capture." />
        </service>
    </application>

</manifest>
